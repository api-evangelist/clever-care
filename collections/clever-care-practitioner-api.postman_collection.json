        {
          "id": "6ec0807a-a4e7-477a-b938-24feb496ee66",
          "name": "Search for Practitioner resources",
          "request": {
            "name": "Search for Practitioner resources",
            "description": {
              "content": "Search for Practitioner resources. Since this API supports multiple HL7 profiles, if you do not provide a value for `_profile` a default value of `http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Practitioner` will be used.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "A server defined search that may match any of the string fields\nin the `HumanName`, including `family`, `give`, `prefix`, `suffix`, and/or\n`text` (Select Practitioners with the specified name (matches against any\nof the elements in the HumanName data type)). \nSupported profiles - [http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Practitioner]\n"
                },
                {
                  "disabled": false,
                  "key": "given",
                  "value": "<string>",
                  "description": "A portion of the given name (Select Practitioners with the specified given name). Supported profiles - [http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Practitioner]"
                },
                {
                  "disabled": false,
                  "key": "family",
                  "value": "<string>",
                  "description": "A portion of the family name (Select Practitioners with the specified family name). Supported profiles - [http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Practitioner]"
                },
                {
                  "disabled": false,
                  "key": "_offset",
                  "value": "<string>",
                  "description": "Pagination offset (Default: 0)"
                },
                {
                  "disabled": false,
                  "key": "_count",
                  "value": "<string>",
                  "description": "Resource count (total) per bundle (Default: 10)"
                },
                {
                  "disabled": false,
                  "key": "_profile",
                  "value": "<string>",
                  "description": "Select resources based on a given HL7 profile.\ndefault value: `http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Practitioner`\n"
                },
                {
                  "disabled": false,
                  "key": "_id",
                  "value": "<string>",
                  "description": "Select resource based on the logical `id`."
                },
                {
                  "disabled": false,
                  "key": "_lastUpdated",
                  "value": "<string>",
                  "description": "Select resources based on the last time they were changed.\n\n- Only date is supported in `yyyy-mm-dd` format.\n- Prefixes supported are `eq`, `ne`, `gt`, `lt`, `ge` and `le`. Refer to their definitions at http://hl7.org/fhir/search.html#prefix.\n\neg: `_lastUpdated=eq2021-01-14`\n"
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "authUrl",
                  "value": "https://fhir.clevercarehealthplan.com/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "implicit"
                }
              ]
            }
