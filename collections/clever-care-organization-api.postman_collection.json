        {
          "id": "6e6f712f-c4e5-4726-aaac-47c4166c8e25",
          "name": "Search for Organization resources.",
          "request": {
            "name": "Search for Organization resources.",
            "description": {
              "content": "Search for Organization resources. Since this API supports multiple HL7 profiles, if you do not provide a value for `_profile` a default value of `http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Organization` will be used.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "Select organizations with the specified address (matches any\nof the string elements of an address). Supported profiles - [http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Organization]\n"
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Select Organizations with the specified name. Supported profiles\n- [http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Organization]\n"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "A code for the type of organization (Select Organizations of the specified type). \nSupported profiles - [http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Organization]\n"
                },
                {
                  "disabled": false,
                  "key": "endpoint",
                  "value": "<string>",
                  "description": "Technical endpoints providing access to services operated for\nthe organization (Select Organizations with the specified endpoint). \nSupported profiles - [http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Organization]\n"
                },
                {
                  "disabled": false,
                  "key": "coverage-area",
                  "value": "<string>",
                  "description": "Select health insurance provider networks available in a region\ndescribed by the specified location. Supported profiles - [http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Network]\n"
                },
                {
                  "disabled": false,
                  "key": "_offset",
                  "value": "<string>",
                  "description": "Pagination offset (Default: 0)"
                },
                {
                  "disabled": false,
                  "key": "_count",
                  "value": "<string>",
                  "description": "Resource count (total) per bundle (Default: 10)"
                },
                {
                  "disabled": false,
                  "key": "_profile",
                  "value": "<string>",
                  "description": "Select resources based on a given HL7 profile.\ndefault value: `http://hl7.org/fhir/us/davinci-pdex-plan-net/StructureDefinition/plannet-Organization`\n"
                },
                {
                  "disabled": false,
                  "key": "_id",
                  "value": "<string>",
                  "description": "Select resource based on the logical `id`."
                },
                {
                  "disabled": false,
                  "key": "_lastUpdated",
                  "value": "<string>",
                  "description": "Select resources based on the last time they were changed.\n\n- Only date is supported in `yyyy-mm-dd` format.\n- Prefixes supported are `eq`, `ne`, `gt`, `lt`, `ge` and `le`. Refer to their definitions at http://hl7.org/fhir/search.html#prefix.\n\neg: `_lastUpdated=eq2021-01-14`\n"
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "authUrl",
                  "value": "https://fhir.clevercarehealthplan.com/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "implicit"
                }
              ]
            }
